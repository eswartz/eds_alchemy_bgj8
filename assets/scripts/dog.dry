use $sys.calls.*;

def min(x: RealF, y: RealF) -> RealF {
    if x < y then x else y end
}
def max(x: RealF, y: RealF) -> RealF {
    if x > y then x else y end
}
def clamp(v: RealF, min: RealF, max: RealF) -> RealF {
    if v < min then min elif v > max then max else v end
}
def abs(x: RealF) -> RealF {
    if x < 0 then -x else x end
}

def choose(lst: Tuple) -> Any {
    let idx = random_number(0, sequence_length(lst))
    lst[idx as UnsF]
}

def on_init(ctx: Struct, ent: Uns64, data: Struct, ...) {
    var others: Any = nil  ## or Uns64
    while not others do
        print("waiting for cat ", others, "\n")
        delay(0.0)
        others = bevy_call_func(ent, 'find_entity_named',
            "(?i)^cat-0$", true)
    end

    print("got cat ", bevy_call_func(others[0], 'ent_to_string'), "\n")
    data.other = others[0]
    data.max_speed = 3.0
    data.speed = 0.25
    data.accel = random_number(1.1, 1.2)

    ## Store original positions.
    let start_pos = bevy_call_func(ent, 'get_position', 'World')
    data.start_pos = start_pos

    let other_pos = bevy_call_func(data.other, 'get_position', 'World')
    print("other_pos: ", other_pos,  "\n")
    data.other_pos = other_pos

    bevy_call_func(ent, 'play_sound', [
        'source': ['Asset', "sounds/157283__samueljustice00__pug-1.ogg"],
        volume: ['Linear', 0.25],
    ])
    delay(random_number(0.45, 0.55))
    ##bevy_call_func(ent, 'play_sound', [
   ##     'source': ['Asset', "sounds/273688__richerlandtv__pug-woof-2.ogg"],
    ##    volume: ['Linear', 0.5],
    ##])
    delay(random_number(0.20, 0.30))

    delay(random_number(0.65, 0.85))

    data.phase = 'idle'
}

def on_update(ctx: Struct, ent: Uns64, data: Struct, ...) {
    let pos = bevy_call_func(ent, 'get_position', 'World')
    let goal = data.other_pos

    let other_pos = bevy_call_func(data.other, 'get_position', 'World')
    ##print("other_pos: ", other_pos,  "\n")
    data.other_pos = other_pos


    ## Directional distance from our goal.
    var dx = goal.x - pos.x
    var dy = goal.y - pos.y
    var dz = goal.z - pos.z

    let dist = ((dx * dx) + (dy * dy) + (dz * dz)) ** 0.5
    ##print([:, dist, dx, dy, dz], "\n")

    bevy_call_func(ent, 'look_at', data.other, 0.25)

    var sleep = 0.1
    let vel = if dist > 1.5 then

        let speed = clamp(data.speed * dist, 0.0, data.max_speed)
        data.speed *= data.accel

        let vx = dx * speed / dist + random_number(-2, 2)
        let vy = dy * speed / dist
        let vz = dz * speed / dist + random_number(-1, 1)

        [x: vx, y: vy, z: vz]
    else
        ## too close

        if random_number(0.0, 1.0) < 0.5 then
            bevy_call_func(ent, 'play_sound', [
                  ##'source': ['Asset', "sounds/273688__richerlandtv__pug-woof-2.ogg"],
                  'source': ['Asset',
                        choose([
                            "sounds/157283__samueljustice00__pug-1.ogg",
                            "sounds/157283__samueljustice00__pug-2.ogg",
                            "sounds/273688__richerlandtv__pug-woof-2.ogg",
                            "sounds/157283__samueljustice00__pug-3.ogg",
                            "sounds/813118__qubodup__dogs-cats-crows-dog-1.ogg",
                            "sounds/813118__qubodup__dogs-cats-crows-dog-2.ogg",
                        ])
                    ],
                volume: ['Linear', random_number(0.5, 1.0)],
                pitch_scale: random_number(0.5, 2.0),
            ])
        end

        sleep = 0.125
        dx = data.start_pos.x - pos.x
        dy = data.start_pos.y - pos.y
        dz = data.start_pos.z - pos.z

        [x: dx * 1.0 + random_number(-10.0, 10.0), y: 0, z: dz * 2.0 + random_number(-10.0, 10.0)]

    end

    if pos.y < 0.25 or pos.y > 1 then
        vel.y = -pos.y * 10.0
    end

    ##print(bevy_call_func(ent, 'ent_to_string'), " new vel: ", vel, "\n")
    bevy_call_func(ent, 'insert_components', 'LinearVelocity', vel)

    delay(random_number(0.00, 0.03) + sleep/3)
}

[
init_data: [:],
    on_init,
    on_update,
]

