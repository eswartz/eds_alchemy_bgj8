use $sys.calls.*;

def min(x: RealF, y: RealF) -> RealF {
    if x < y then x else y end
}
def max(x: RealF, y: RealF) -> RealF {
    if x > y then x else y end
}
def clamp(v: RealF, min: RealF, max: RealF) -> RealF {
    if v < min then min elif v > max then max else v end
}
def abs(x: RealF) -> RealF {
    if x < 0 then -x else x end
}

def X_HSIZE: RealF = 16.0
def Z_HSIZE: RealF = 16.0

def earth(ctx: Struct, ent: Uns64, data: Struct, param: Tuple) {
    bevy_call_func('remove_spawned')
    bevy_call_func('apply_motion_blur', [shutter_angle: 0.0, samples: 0])
    bevy_call_func('set_gravity', -9.8)
    bevy_call_func('set_player_mode', 'Fps')
    bevy_call_func('set_player_input', 'Fps')

    let height: IntF = param[1] as IntF
    let width: IntF = param[0] as IntF // 2
    let depth: IntF = param[2] as IntF // 2
    let size: RealF = param[3] as RealF * 0.95
    let mat: String = param[4]
    let dist = size * 2
    var z: IntF = -depth
    while z <= depth do
        var y: IntF = 0
        while y < height do
            var x: IntF = -width
            while x < width do
                let hue = ((x * y * 20) % 360) as RealF
                let color = ['Hsva', 'hue', hue, 'saturation', 0.875, 'value', 0.5]
                bevy_call_func('spawn_entity',
                    'Name', "spawn",
                    'offset', [:, x: x * dist, y: y * dist + 0.5, z: z * dist -2.0],
                    'shape', ['Cube', 'x', size, 'y', size, 'z', size],
                    ## 'shape', ['Sphere', size],
                    'rigid_body', 'Dynamic',
                    'color', color,
                    'mass', 100.0, ## * (60 - y) / 5.0,
                    'SurfaceMaterial', mat,
                    'LinearDamping', 0.25,
                    'AngularDamping', 0.25,
                    'restitution', 0.1,
                    'friction', 0.5,
                    'swept_ccd', 'linear',
                    'CollisionMargin', 0.0,
                    'CrosshairTargetable', nil,
                    'double_sided', false,
                    'Spawned', nil,
                );
                x += 1
            end
            y += 1
        end
        z += 1
    end
}

def ents_of(lst) -> Tuple {
    var out = []
    var i = 0
    while i < sequence_length(lst) do
        sequence_append(out, bevy_call_func(lst[i], 'ent_to_string'))
        i += 1
    end
    out
}

[@doc: "Spawn the cat and dog at the given offset vector"]
def fire(ctx: Struct, ent: Uns64, data: Struct, params: Tuple) {
    bevy_call_func('set_gravity', -9.8)
    bevy_call_func('set_player_mode', 'Fps')
    bevy_call_func('set_player_input', 'Fps')
    bevy_call_func('apply_motion_blur', [shutter_angle: 0.0, samples: 0])

    let x: RealF = params[0]
    let y: RealF = params[1]
    let z: RealF = params[2]
    let strength: RealF = params[3]

    bevy_call_func('remove_spawned')
##{  ## wasn't working to really remove the elements, using the call above instead
    if let dogs = bevy_call_func(ent, 'find_entity_named', "(?i)^(dog|dog-0|.*\\bPug\\b.*)$", true) then
        print("removing dogs ", ents_of(dogs), "\n")
        var i = 0
        while i < sequence_length(dogs) do
            let cand = bevy_call_func(dogs[i], 'get_scene_parent')
            bevy_call_func('despawn_entity', cand or dogs[i])
            i += 1
        end
    end
    if let cats = bevy_call_func(ent, 'find_entity_named', "(?i)^(cat|cat-0|Cubic.*)$", true) then
        print("removing cats ", ents_of(cats), "\n")
        var i = 0
        while i < sequence_length(cats) do
            let cand = bevy_call_func(cats[i], 'get_scene_parent')
            bevy_call_func('despawn_entity', cand or cats[i])
            i += 1
        end
    end
##}

    let pet_scale = 5.0

    let dog_offs = [:, x, y, z: z + 3.0]
    let dog_rot = ['Deg', [y: 45.0, x: 0, z: 0]]
    let cat_offs = [:, x: -x, y, z]
    let cat_rot = ['Deg', [y: 90.0, x: 0, z: 0]]

    let dog_ent = bevy_call_func('spawn_entity',
        ##'parent', ent,
        'Name', "dog-0",
        'offset', dog_offs,
        'rotation', dog_rot,
        'scale', pet_scale,
        'shape', ['Model', "models/pug-0.glb#Scene0"],
        'CrosshairTargetable', nil,
        'RigidBody', 'Kinematic',
    );
    bevy_call_func(dog_ent, 'add_script', [
        path: 'scripts/dog.dry', mode: 'Async',
    ], [parent: ent])

    let dog_parts_ent = bevy_call_func('spawn_entity',
        'ChildOf', dog_ent,
        ##'offset', dog_offs,
        ##'rotation', dog_rot,
        ##'scale', pet_scale,

        'Name', "dog",
        'shape', ['Model', "models/pug.glb#Scene0"],
        'CrosshairTargetable', nil,
    );


    let cat_ent = bevy_call_func('spawn_entity',
        ##'parent', ent,
        'offset', [:, x: -x, y, z],
        'rotation', cat_rot,
        'scale', pet_scale,

        'Name', "cat-0",
        'shape', ['Model', "models/cat-0.glb#Scene0"],
        'CrosshairTargetable', nil,
        'RigidBody', 'Kinematic',
    );
    bevy_call_func(cat_ent, 'add_script', [
        path: 'scripts/cat.dry', mode: 'Async',
    ], [parent: ent])

    let cat_parts_ent = bevy_call_func('spawn_entity',
        'ChildOf', cat_ent,
        ##'offset', cat_offs,
        ##'rotation', cat_rot,
        ##'scale', pet_scale,

        'Name', "cat",
        'shape', ['Model', "models/cat.glb#Scene0"],
        'CrosshairTargetable', nil,
        'SurfaceMaterial', 'Glass',
        'Mass', 0.125,
    );

    ## Wait for the models above to be fully loaded,
    ## trigger WorldInstanceReady, then for the callback
    ## below to ...
    while not bevy_call_func(cat_ent, 'make_children_physical_after_collision', cat_parts_ent) do
        delay(0.1)
    end

    while not bevy_call_func(dog_ent, 'make_children_physical_after_collision', dog_parts_ent) do
        delay(0.1)
    end

##{
    let rigid = bevy_call_func('get_rigid_entity', cat_ent)
    bevy_call_func(rigid, 'insert_components',
        'CrosshairTargetable', nil,
        'rigid', 'Dynamic',
        'collision_layers', 'default|gameplay|world',
        'Mass', 10.0,
        'SurfaceMaterial', 'Glass',
    )
    let rigid = bevy_call_func('get_rigid_entity', dog_ent)
    bevy_call_func(rigid, 'insert_components',
        'CrosshairTargetable', nil,
        'rigid', 'Dynamic',
        'collision_layers', 'default|gameplay|world',
        'Mass', 25.0,
        'SurfaceMaterial', 'Stone',
    )
##}
}

def water(ctx: Struct, ent: Uns64, data: Struct, param: Tuple) {
    bevy_call_func('remove_spawned')
    bevy_call_func('apply_motion_blur', [shutter_angle: 0.0, samples: 0])
    bevy_call_func('set_gravity', -9.8)
    bevy_call_func('set_player_mode', 'Fps')
    bevy_call_func('set_player_input', 'Fps')

    let depth: RealF = param[0] as RealF
    let items: IntF = param[1] as IntF
    let size: RealF = param[2] as RealF

    bevy_call_func(ent, 'spawn_water', depth, [x: 4, y: 4])

    bevy_call_func('spawn_entity',
        'Name', "water",
        'offset', [:, x: 0, z: 0, y: depth/2],
        'shape', ['Cube', 'x', X_HSIZE*2.5, 'z', Z_HSIZE*2.5, 'y', depth],
        'color', ['Hsva', 'alpha', 0.0],
        'Spawned', nil,
        'Sensor', nil,
        'rigid', 'Static',      ## ensures collider
        'SurfaceMaterial', 'Water',
        'Water', nil,
        'double_sided', true,
    )

    var i: IntF = 0
    while i < items do
        i += 1
        let hue = ((i * 17) % 360) as RealF
        let color = ['Hsva', 'hue', hue, 'saturation', 0.875, 'value', 0.75]
        let x = random_number(-X_HSIZE, X_HSIZE)
        let z = random_number(-Z_HSIZE, Z_HSIZE)
        bevy_call_func('spawn_entity',
            'Name', "spawn",
            'offset', [:, x, z, y: depth],
            'shape', ['Sphere', random_number(max(0.1, size / 2 - 0.5), size / 2 + 0.5)],
            'rigid_body', 'Dynamic',
            'color', color,
            'mass', 10.0, ## * (60 - y) / 5.0,
            'SurfaceMaterial', 'Synthetic',
            'LinearDamping', 0.5,
            'AngularDamping', 0.5,
            'restitution', 0.25,
            'friction', 0.2,
            'swept_ccd', 'linear',
            'CollisionMargin', 0.0,
            'Spawned', nil,
            'Floating', nil,
        );
    end
}

def air(ctx: Struct, ent: Uns64, data: Struct, param: Tuple) {
    bevy_call_func('remove_spawned')
    bevy_call_func('apply_motion_blur', [shutter_angle: 2.0, samples: 2])
    bevy_call_func('set_gravity', 0)
    bevy_call_func('set_player_mode', 'Space')
    bevy_call_func('set_player_input', 'Space')

    let count: UnsF = param[0] as UnsF
    let size: RealF = param[1] as RealF
    let mass: RealF = param[2] as RealF

    var i: UnsF = 0
    while i < count do
        i += 1
        let hue = ((i * 17) % 360) as RealF
        let color = ['Hsva', 'hue', hue, 'saturation', 0.875, 'value', 1.0]
        let emissive_color = ['Hsva', 'hue', hue, 'saturation', 0.875, 'value', 3.0]
        let x = random_number(-X_HSIZE, X_HSIZE)
        let y = random_number(0, X_HSIZE)
        let z = random_number(-Z_HSIZE, Z_HSIZE)
        let scale = random_number(0.5, 3.0)
        let size = size * scale
        let mass = mass * scale
        let spawned = bevy_call_func('spawn_entity',
            'Name', "star",
            'offset', [:, x, z, y],
            'shape', ['Sphere', size],
            'rigid', 'Dynamic',
            'color', color,
            'emissive', emissive_color,
            'mass', mass,
            'SurfaceMaterial', 'Stone',
            'Spawned', nil,
            'alpha_mode', 'Add',
            'GravityObject', [
                density: 1.0e5,
                radius: size,
            ],
            'SleepThreshold', [
                linear: 0.,
                angular: 0.,
            ],
            'GravityScale', 0.0,
            'CenterOfMass', [:],
            'collision_layers', 'gameplay|projectile',
            'collider_shape', ['Sphere', 0.001],
            'Bloom', [intensity: 0.5],
            'swept_ccd', 'off',
        );

        if random_number(0.0, 1.0) < 0.25 then
            bevy_call_func(spawned, 'add_script', [
                path: 'scripts/star.dry', mode: 'Async',
            ])
        end
    end
}

def FUNCS = [:,
    earth,
    fire,
    water,
    air,
]
