use $sys.calls.*;

def hello(param: String) {
    let size = 0.475 * 2.0
    let dist = 0.5 * 2
    var y: IntF = 0
    while y < 2 do
        var x: IntF = -5
        while x < 5 do
            let hue = ((x * y * 20) % 360) as RealF
            let color = ['Hsva', 'hue', hue, 'saturation', 0.875, 'value', 0.5]
            bevy_call_func('spawn_entity',
                'Name', "spawn",
                'offset', [:, x: x * dist, y: y * dist + 0.5, z: -2.0],
                'shape', ['Cube', 'x', size, 'y', size, 'z', size],
                'rigid_body', 'Dynamic',
                'color', color,
                'mass', 100.0, ## * (60 - y) / 5.0,
                'SurfaceMaterial', 'Glass',
                'LinearDamping', 0.25,
                'AngularDamping', 0.25,
                'restitution', 0.0,
                'friction', 0.9,
                'swept_ccd', 'linear',
                'CollisionMargin', 0.0,
                'CrosshairTargetable', nil,
                'double_sided', false,
            );
            x += 1
        end
        y += 1
    end

}

def spawn(param: RealF) {
    print("spawn ", param, "\n")
}

[@doc: "Spawn the cat and dog at the given offset vector"]
def spawn_pets(offs: Tuple) {
    let x = offs[0]
    let y = offs[1]
    let z = offs[1]

    let dog_ent = bevy_call_func('spawn_entity',
        'Name', "dog-0",
        'offset', [:, x, y, z],
        'rotation', ['Deg', [y: 90.0, x: 0, z: 0]]
        'shape', ['Model', "models/pug-0.glb#Scene0"],
        'scale', 5.0,
        'CrosshairTargetable', nil,
        'RigidBody', 'Kinematic',
    );
    bevy_call_func(dog_ent, 'add_script', [
        path: 'scripts/dog.dry', mode: 'Async',
    ], [:])

    let dog_parts_ent = bevy_call_func('spawn_entity',
        'ChildOf', dog_ent,
        'Name', "dog",
        'shape', ['Model', "models/pug.glb#Scene0"],
        'CrosshairTargetable', nil,
    );

    let cat_ent = bevy_call_func('spawn_entity',
        'Name', "cat-0",
        'offset', [:, x: -x, y, z],
        'rotation', ['Deg', [y: -90.0, x: 0, z: 0]]
        'shape', ['Model', "models/cat-0.glb#Scene0"],
        'scale', 5.0,
        'CrosshairTargetable', nil,
    );

    let cat_parts_ent = bevy_call_func('spawn_entity',
        'ChildOf', cat_ent,
        'Name', "cat",
        'shape', ['Model', "models/cat.glb#Scene0"],
        'CrosshairTargetable', nil,
    );

    ## Wait for the models above to be fully loaded,
    ## trigger WorldInstanceReady, then for the callback
    ## below to ...
    while not bevy_call_func(cat_ent, 'make_children_physical_after_collision', cat_parts_ent) do
        delay(0.1)
    end

    while not bevy_call_func(dog_ent, 'make_children_physical_after_collision', dog_parts_ent) do
        delay(0.1)
    end


}

def FUNCS = [:,
    hello,
    spawn,
    spawn_pets,
]
